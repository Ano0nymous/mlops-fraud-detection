FROM python:3.10-slim

# Install MLflow with PostgreSQL and S3 support
RUN pip install --no-cache-dir \
    mlflow==2.14.1 \
    psycopg2-binary \
    boto3

# Expose the default MLflow port
EXPOSE 5000

# Run as non-root (optional but good practice)
RUN useradd --create-home mlflowuser
USER mlflowuser

# Default command
CMD ["mlflow", "server", "--host", "0.0.0.0", "--port", "5000"]
